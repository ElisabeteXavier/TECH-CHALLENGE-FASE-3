# Copie para .env e preencha com seus valores reais:
#   cp .env.example .env

OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# Alias aceito pelo gerar_dados.py (opcional se LLM_MODEL estiver definido)
OPENAI_MODEL=gpt-4o-mini

# Embeddings: use all-MiniLM-L6-v2 em dev (mais leve); bge-m3 em produção
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

CHUNK_SIZE=1500
CHUNK_OVERLAP=300
RAG_K=5
RAG_FETCH_K=20
# Estratégia de busca: mmr (padrão) ou similarity
RAG_SEARCH_TYPE=mmr
